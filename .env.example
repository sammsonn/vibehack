GITHUB_APP_ID=1234567
GITHUB_APP_KEY_PATH=github-app.pem
LIVE_REPO=owner/repo

# Reserved for the "before" metric on a historical repo the app isn't installed on (read-only token).
# Read by the config but not used yet. GITHUB_TOKEN_1 is used if GITHUB_TOKEN is empty.
GITHUB_TOKEN=
BEFORE_REPO=owner/repo-with-pr-history

LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=openai/gpt-oss-120b

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

GOOGLE_BOT_EMAIL=your-bot@gmail.com   # the Google account that ran scripts.google_login

# Optional, defaults shown
STALE_HOURS=4
PRECALL_MINUTES=10
POLL_MINUTES=5
LOG_LEVEL=INFO

# Assumptions behind "Saved ~X developer-hours ≈ €Y vs ~$Z model cost" in /radar stats (defaults shown)
BASELINE_WAIT_HOURS=8        # typical review wait without Radar, from the interview; used until the live repo has 3+ PRs reviewed without Radar
BLOCKED_COST_FACTOR=0.25     # developer-hours lost per hour a PR waits (0.25 = 15 min of context switching per hour)
DEV_HOURLY_EUR=20
LLM_USD_PER_M_INPUT=0.10     # model price per 1M tokens; Radar logs the real token count of every call
LLM_USD_PER_M_OUTPUT=0.50
BUY_TOOL_NAME=CodeRabbit Team  # the per-seat tool Radar is compared with ("Buying instead" line); seats = people in team.json
BUY_TOOL_USD_PER_SEAT=48       # coderabbit.ai/pricing, Team plan billed annually (Nov 2026)
RADAR_HOSTING_USD_PER_MONTH=5  # what running the container costs you (small VPS); 0 if it runs on a machine you already pay for

# Optional file locations, relative to the repo (or RADAR_HOME). docker-compose.yml sets its own.
# RADAR_TEAM_FILE=team.json
# RADAR_DB_PATH=radar.db          (the lock and heartbeat files are created next to it)
# GOOGLE_TOKEN_PATH=token.json
# GOOGLE_CREDENTIALS_PATH=credentials.json
