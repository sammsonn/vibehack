GITHUB_APP_ID=1234567
GITHUB_APP_KEY_PATH=github-app.pem
LIVE_REPO=owner/repo

# Optional: read-only token, only for the before metric on a repo the app isn't installed on
GITHUB_TOKEN=
BEFORE_REPO=owner/repo-with-pr-history

LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

GOOGLE_BOT_EMAIL=your-bot@gmail.com

# Optional, defaults shown
STALE_HOURS=4
PRECALL_MINUTES=10
POLL_MINUTES=5
